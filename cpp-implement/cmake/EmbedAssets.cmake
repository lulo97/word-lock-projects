# EmbedAssets.cmake
# Generates C++ byte arrays from asset files at configure time.
# Usage: target_embed_assets(<target> [NAMESPACE <ns>] <file>...)

function(target_embed_assets target_name)
    cmake_parse_arguments(ARG "" "OUT_DIR;NAMESPACE" "" ${ARGN})

    if(NOT ARG_OUT_DIR)
        set(ARG_OUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/embedded_assets")
    endif()
    if(NOT ARG_NAMESPACE)
        set(ARG_NAMESPACE "assets")
    endif()

    file(MAKE_DIRECTORY "${ARG_OUT_DIR}")

    set(HEADER_FILE "${ARG_OUT_DIR}/embedded_assets.h")
    set(SOURCE_FILE "${ARG_OUT_DIR}/embedded_assets.cpp")

    set(HEADER_CONTENT "#pragma once\n\n#include <cstddef>\n\nnamespace ${ARG_NAMESPACE} {\n\n")
    set(SOURCE_CONTENT "// Auto-generated by EmbedAssets.cmake - do not edit.\n#include \"embedded_assets.h\"\n\nnamespace ${ARG_NAMESPACE} {\n\n")

    foreach(ASSET_PATH IN LISTS ARG_UNPARSED_ARGUMENTS)
        if(NOT EXISTS "${ASSET_PATH}")
            message(FATAL_ERROR "Embedded asset not found: ${ASSET_PATH}")
        endif()

        get_filename_component(RAW_NAME "${ASSET_PATH}" NAME)
        string(REGEX REPLACE "[^A-Za-z0-9_]" "_" VAR_NAME "${RAW_NAME}")

        file(READ "${ASSET_PATH}" HEX_DATA HEX)
        string(LENGTH "${HEX_DATA}" HEX_LEN)
        math(EXPR BYTE_LEN "${HEX_LEN} / 2")

        string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1, " ARRAY_BODY "${HEX_DATA}")
        string(REGEX REPLACE ", $" "" ARRAY_BODY "${ARRAY_BODY}")

        string(APPEND HEADER_CONTENT
            "extern const unsigned char ${VAR_NAME}[];\n"
            "extern const std::size_t ${VAR_NAME}_size;\n\n")

        string(APPEND SOURCE_CONTENT
            "const unsigned char ${VAR_NAME}[] = {\n    ${ARRAY_BODY}\n};\n"
            "const std::size_t ${VAR_NAME}_size = ${BYTE_LEN};\n\n")
    endforeach()

    string(APPEND HEADER_CONTENT "} // namespace ${ARG_NAMESPACE}\n")
    string(APPEND SOURCE_CONTENT "} // namespace ${ARG_NAMESPACE}\n")

    file(WRITE "${HEADER_FILE}" "${HEADER_CONTENT}")
    file(WRITE "${SOURCE_FILE}" "${SOURCE_CONTENT}")

    target_sources("${target_name}" PRIVATE "${SOURCE_FILE}")
    target_include_directories("${target_name}" PRIVATE "${ARG_OUT_DIR}")
endfunction()
