{
  "applicationId": "com.pomodorolock.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 47831,
  "documentRoot": "/resources/",
  "url": "/src/host/host.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false
  },
  "nativeAllowList": [
    "app.broadcast",
    "app.exit",
    "window.create",
    "window.hide",
    "window.show",
    "window.move",
    "window.setSize",
    "window.setAlwaysOnTop",
    "window.focus",
    "window.maximize",
    "window.beginDrag",
    "os.execCommand",
    "os.getEnv",
    "os.setTray",
    "os.showMessageBox",
    "filesystem.createDirectory",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.move",
    "filesystem.copy",
    "filesystem.remove",
    "events.broadcast",
    "extensions.dispatch",
    "extensions.getStats"
  ],
  "modes": {
    "window": {
      "title": "PomodoroLock Countdown",
      "icon": "/resources/assets/icon.png",
      "width": 100,
      "height": 50,
      "borderless": true,
      "alwaysOnTop": true,
      "resizable": false,
      "maximizable": false,
      "exitProcessOnClose": false,
      "enableInspector": false,
      "injectGlobals": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "pomodorolock",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  },
  "extensions": [
    {
      "id": "js.wordlock.native",
      "commandWindows": "${NL_PATH}/extensions/wordlock-native.exe"
    }
  ]
}